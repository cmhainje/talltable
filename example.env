# URL of the Talltable web service (optional, has a default)
# TALLTABLE_URL=https://talltable.flatironinstitute.org

# Path to the output database directory (required for local queries and pipeline)
TALLTABLE_DB_DIR=~/db

# Path to raw FITS image files (required for pipeline/ingest only)
TALLTABLE_DATA_DIR=~/data

# Temporary scratch directory for ingest (optional, defaults to TALLTABLE_DB_DIR)
# TALLTABLE_SCRATCH_DIR=~/scratch
